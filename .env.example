# Server Port
PORT=4000

# JWT Authentication
JWT_SECRET=your_jwt_secret_key

# Admin Email (used for seeding and admin alerts)
ADMIN_EMAIL=admin@example.com

# Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ebuilding-hrms
# MONGODB_URI=mongodb://localhost:27017/ebuilding-hrms

# Inngest (Background and Cron Jobs)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# SMTP Configuration (Email Service)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SENDER_EMAIL=noreply@example.com

# Cron Schedules & Timezones
CRON_TIMEZONE=Asia/Kolkata
ATTENDANCE_CRON_SCHEDULE="0 0 * * *"

# Cloudinary (Media & Document Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend App URL
FRONTEND_URL=http://localhost:5173
